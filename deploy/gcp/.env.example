# Base domain only. For an initial beta, 34.123.45.67.sslip.io works after
# replacing the example IP with the VM's reserved external IP.
DOMAIN=34.123.45.67.sslip.io
CADDY_EMAIL=you@example.com

POSTGRES_DB=pethotel
POSTGRES_USER=pethotel
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_DATABASE_PASSWORD=replace-with-a-different-long-random-password

MINIO_ROOT_USER=tailtells-staging
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_BUCKET=tail-tells-media-staging

# Keep low-confidence dog/cat proposals visible for manager confirmation.
DETECTION_REVIEW_THRESHOLD=0.10
# Keep resnet18 until DINOv2 passes the labeled-photo evaluation. Set to
# dinov2_vits14_reg for a controlled rollout; weights persist in model_cache.
INFERENCE_EMBEDDER_BACKEND=resnet18

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-different-at-least-32-random-bytes

# Optional report-email delivery.
# SendGrid is preferred when both provider keys are configured. The sender must
# be a verified SendGrid Sender Identity (use domain authentication for production).
SENDGRID_API_KEY=
RESEND_API_KEY=
REPORTS_FROM_EMAIL=onboarding@resend.dev
REPORTS_FROM_NAME=UCBarkley
# Staging/beta safety override. When set, no report email is sent to an owner.
REPORTS_TEST_RECIPIENT=
# Public owner-facing report links. Keep the /public/reports path.
PUBLIC_REPORT_BASE_URL=https://api.34.123.45.67.sslip.io/public/reports
