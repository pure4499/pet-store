PORT=3000

# Low-privilege role the API pool connects as at runtime — RLS actually applies to it.
DATABASE_URL=postgres://pethotel_app:pethotel_app_dev@localhost:5432/pethotel

# Superuser role, used only by `npm run migrate` to create schema/roles/policies.
MIGRATE_DATABASE_URL=postgres://pethotel:pethotel_dev@localhost:5432/pethotel

# Local dev uses MinIO as an S3-compatible store; in AWS these point at the real bucket/region instead.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pet-hotel-photos-dev
S3_ACCESS_KEY_ID=pethotel
S3_SECRET_ACCESS_KEY=pethotel_dev_secret
S3_FORCE_PATH_STYLE=true

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Household daily-report email. Without a verified sending domain in Resend,
# real recipient addresses won't receive mail — test against delivered@resend.dev
# in the meantime. https://resend.com/domains
RESEND_API_KEY=
REPORTS_FROM_EMAIL=onboarding@resend.dev
# Optional safety override: route every report email to one test inbox instead
# of any owner address. Leave blank when production owner delivery is enabled.
REPORTS_TEST_RECIPIENT=
PUBLIC_REPORT_BASE_URL=http://localhost:3000/public/reports
