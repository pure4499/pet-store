# Same low-privilege runtime role the API uses — RLS applies to the worker too.
DATABASE_URL=postgres://pethotel_app:pethotel_app_dev@localhost:5432/pethotel

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pet-hotel-photos-dev
S3_ACCESS_KEY_ID=pethotel
S3_SECRET_ACCESS_KEY=pethotel_dev_secret
S3_FORCE_PATH_STYLE=true

INFERENCE_SERVICE_URL=http://localhost:8000

# Local dev polls Postgres directly for uploaded photos instead of SQS (see
# queue/photoQueue.ts) — no queue infra needed to run the pipeline locally.
POLL_INTERVAL_MS=3000

# Report videos use the bundled ffmpeg-static binary. Rendering stays in this
# asynchronous worker so API requests never wait for video encoding.
